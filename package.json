{
  "name": "pptxdiff",
  "version": "0.4.2",
  "description": "A diff tool to compare two PowerPoint decks. Completely local, no cloud upload.",
  "license": "Apache-2.0",
  "private": false,
  "author": {
    "name": "Sugato Ray",
    "email": "sugatoray.dev@gmail.com",
    "url": "https://github.com/sugatoray"
  },
  "bin": {
    "pptxdiff": "bin/cli.js"
  },
  "scripts": {
    "build:npm": "mkdir -p dist && npm pack --pack-destination dist",
    "package:vscode": "cd src/packages/pptxdiff-vscode && mkdir -p dist && vsce package --out dist/pptxdiff-vscode-$(node -p \"require('./package.json').version\").vsix"
  },
  "files": [
    "bin",
    "src/pptxdiff/index.html",
    "src/pptxdiff/support.js",
    "src/pptxdiff/sample-pptx.js",
    "src/pptxdiff/vendor",
    "docs/assets/pptxdiff_banner.png",
    "docs/assets/pptxdiff_logo.png",
    "docs/assets/icon.png",
    "docs/assets/pptxdiff_demo_1_allpairs.png",
    "docs/assets/sample_*.pptx"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@aiden0z/pptx-renderer": "^1.2.4",
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.0.0",
    "typescript": "^5.2.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sugatoray/pptxdiff.git"
  },
  "homepage": "https://github.com/sugatoray/pptxdiff#readme",
  "keywords": [
    "pptx",
    "powerpoint",
    "diff",
    "compare",
    "cli",
    "presentation-review"
  ],
  "bugs": {
    "url": "https://github.com/sugatoray/pptxdiff/issues"
  }
}
